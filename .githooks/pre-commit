#!/bin/sh
# Blocks commits that contain secrets. CI runs the same scan.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks). Commit blocked." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --log-level warn
