#!/bin/sh
# Enforces conventional commits on the first line. CI runs this on every pushed commit.
subject=$(head -n 1 "$1")
if printf '%s\n' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .+|^Merge '; then
  exit 0
fi
echo "commit-msg: \"$subject\" is not a conventional commit, e.g. \"feat(core): add form model\"." >&2
exit 1
